# Test environment — used by pytest
# This file is committed. Do NOT put real secrets here.
ENVIRONMENT=development
APP_NAME=civictrace-api
APP_VERSION=0.1.0
LOG_LEVEL=WARNING
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000
SECRET_KEY=test-secret-key-do-not-use-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql+asyncpg://civictrace:civictrace@localhost:5432/civictrace_test
DATABASE_URL_SYNC=postgresql+psycopg://civictrace:civictrace@localhost:5432/civictrace_test
POSTGRES_USER=civictrace
POSTGRES_PASSWORD=civictrace
POSTGRES_DB=civictrace_test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
