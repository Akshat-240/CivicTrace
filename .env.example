# =============================================================================
# CivicTrace — Environment Configuration
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
# Options: development | staging | production

APP_NAME=civictrace-api
APP_VERSION=0.1.0

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# REQUIRED in staging/production. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# JWT token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Database — PostgreSQL + PostGIS
# ---------------------------------------------------------------------------
# Async DSN used by SQLAlchemy + asyncpg
DATABASE_URL=postgresql+asyncpg://civictrace:civictrace@localhost:5432/civictrace

# Sync DSN used by Alembic migrations only
DATABASE_URL_SYNC=postgresql+psycopg://civictrace:civictrace@localhost:5432/civictrace

# Postgres credentials (used by Docker Compose)
POSTGRES_USER=civictrace
POSTGRES_PASSWORD=civictrace
POSTGRES_DB=civictrace
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy connection pool settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# AI (Provider Selection & Configuration)
# ---------------------------------------------------------------------------
AI_PRIMARY_PROVIDER=azure
AI_FALLBACK_PROVIDER=gemini

# Azure AI Vision (Primary)
AZURE_AI_VISION_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com/
AZURE_AI_VISION_KEY=PASTE_YOUR_AZURE_KEY_HERE

# Google Gemini (Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------------------
# Storage (Supabase)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://dixalqzlkkevfzmanthq.supabase.co
SUPABASE_SECRET_KEY=PASTE_YOUR_SECRET_KEY_HERE
SUPABASE_STORAGE_BUCKET=evidence
